# Contact form (Web3Forms) — get your access key at https://web3forms.com
# Copy this file to .env.local and fill in real values.
PUBLIC_WEB3FORMS_KEY=

# TinaCMS Cloud (only required for production deploys, NOT for local dev)
# Get these at https://app.tina.io
TINA_TOKEN=
NEXT_PUBLIC_TINA_CLIENT_ID=

# Google review sync — only needed by scripts/sync-google-reviews.mjs, never by the site.
# Requires approved access to the Business Profile APIs; see the README.
# Get the refresh token once by running: node scripts/google-oauth-setup.mjs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Optional. Skips account/location discovery, e.g. "accounts/123456/locations/789012".
GOOGLE_LOCATION_NAME=
