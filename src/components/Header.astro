---
import { getSettings, telHref } from "~/lib/content";
import { summarizeHours } from "~/lib/hours";
import OrderOnline from "~/components/OrderOnline.astro";

const settings = await getSettings();
const currentPath = Astro.url.pathname;

const navLinks = [
  { label: "Menu", href: "/menu" },
  { label: "About", href: "/about" },
  { label: "Gallery", href: "/gallery" },
  { label: "Contact", href: "/contact" },
];

function isActive(href: string) {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
}

const tel = telHref(settings.phone);
// Most phone visitors are standing on Front Street deciding where to eat, so the open
// hours ride along in the header rather than waiting at the bottom of the page.
const [openRow] = summarizeHours(settings.hours);
---
<header class="site-header fixed top-0 left-0 right-0 z-50 bg-cream/95 backdrop-blur border-b border-crust">
  <div class="site-header-inner mx-auto max-w-6xl px-5 lg:px-8 flex items-center justify-between gap-4">
    <a href="/" class="shrink-0 group" aria-label={`${settings.businessName} — home`}>
      {/* Two lines of script, the way the hanging sign stacks them. "Pemberville" on its
          own line keeps the full name in the header without squeezing the type, and the
          town still appears on every page without scrolling. */}
      <span class="site-wordmark block text-door" style={`font-family: var(--font-script)`}>
        <span class="site-wordmark-town block leading-none">Pemberville</span>
        <span class="site-wordmark-name block leading-none">Front Street Cafe</span>
      </span>
      <span class="block font-body text-[0.55rem] sm:text-[0.6rem] uppercase tracking-[0.25em] text-ink-soft mt-1">
        Food · Drink
      </span>
    </a>

    <nav class="hidden md:flex items-center gap-4 lg:gap-7 font-body text-sm uppercase tracking-wide">
      {navLinks.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? "page" : undefined}
          class:list={[
            "transition-colors hover:!text-brick",
            isActive(link.href) ? "!text-brick" : "!text-ink",
          ]}
        >
          {link.label}
        </a>
      ))}
      {/* Phone drops to an outline so the filled Order button is the one clear primary. */}
      {tel && (
        <a
          href={tel}
          class="whitespace-nowrap rounded-full border border-brick px-4 py-2 text-xs font-semibold uppercase tracking-wider !text-brick hover:bg-brick hover:!text-cream transition-colors"
        >
          {settings.phone}
        </a>
      )}
      <OrderOnline class="px-4 py-2" />
    </nav>

    <div class="flex items-center gap-1 md:hidden">
      {tel && (
        <a
          href={tel}
          class="flex items-center gap-1.5 rounded-full bg-brick px-3 py-2 text-xs font-semibold uppercase tracking-wider !text-cream"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M3 5a2 2 0 012-2h2.5a1 1 0 01.97.757l.9 3.6a1 1 0 01-.52 1.12l-1.7.85a11 11 0 005.52 5.52l.85-1.7a1 1 0 011.12-.52l3.6.9A1 1 0 0121 14.5V17a2 2 0 01-2 2h-1C9.7 19 3 12.3 3 5z" />
          </svg>
          Call
        </a>
      )}
      <button
        type="button"
        id="mobile-menu-toggle"
        class="p-2.5 text-ink"
        aria-label="Open menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Hours + where we are, on phones, above the fold, on every page. -->
  <div class="md:hidden border-t border-crust/70 bg-crust/40 px-5 py-1 text-xs flex items-center justify-between gap-3">
    {openRow && (
      <span class="truncate font-medium text-ink">{openRow.days} {openRow.time}</span>
    )}
    <OrderOnline class="-my-0.5 shrink-0" />
  </div>

  <div id="mobile-menu" class="md:hidden hidden border-t border-crust bg-cream">
    <nav class="flex flex-col py-2">
      {navLinks.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? "page" : undefined}
          class:list={[
            "px-5 py-3 text-sm uppercase tracking-wide hover:bg-crust/50 transition-colors",
            isActive(link.href) ? "!text-brick" : "!text-ink",
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    if (!menu) return;
    const isOpen = menu.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
    toggle.setAttribute("aria-label", isOpen ? "Close menu" : "Open menu");
  });

  const header = document.querySelector(".site-header");
  function updateScrollState() {
    header?.classList.toggle("is-scrolled", window.scrollY > 40);
  }
  updateScrollState();
  window.addEventListener("scroll", updateScrollState, { passive: true });
</script>

<style>
  /*
   * Pinyon Script has a small x-height and fine hairlines, so it is set larger than the
   * sans wordmark it replaced — at the old 1.35rem the thin strokes disappeared. The town
   * line runs smaller than the name, as on the sign.
   */
  .site-header-inner {
    height: 74px;
    transition: height 300ms ease;
  }
  .site-wordmark-town {
    font-size: 1.05rem;
    transition: font-size 300ms ease;
  }
  .site-wordmark-name {
    font-size: 1.6rem;
    transition: font-size 300ms ease;
  }
  .site-header.is-scrolled .site-header-inner {
    height: 62px;
  }
  .site-header.is-scrolled .site-wordmark-town {
    font-size: 0.9rem;
  }
  .site-header.is-scrolled .site-wordmark-name {
    font-size: 1.3rem;
  }

  @media (min-width: 768px) {
    .site-header-inner {
      height: 104px;
    }
    .site-wordmark-town {
      font-size: 1.35rem;
    }
    .site-wordmark-name {
      font-size: 2.3rem;
    }
    .site-header.is-scrolled .site-header-inner {
      height: 76px;
    }
    .site-header.is-scrolled .site-wordmark-town {
      font-size: 1rem;
    }
    .site-header.is-scrolled .site-wordmark-name {
      font-size: 1.7rem;
    }
  }
</style>
