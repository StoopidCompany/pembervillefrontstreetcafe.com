---
import { getLogo } from "~/lib/logos";
import BrandGlyph from "~/components/BrandGlyph.astro";

interface Props {
  source: "google" | "yelp" | "facebook" | "direct";
  /** Where the review lives. Google's API gives no per-review URL, so this is the listing. */
  url?: string | null;
}

const { source, url } = Astro.props;

const LABELS = {
  google: "Google",
  yelp: "Yelp",
  facebook: "Facebook",
  direct: "told us directly",
} as const;

/*
 * Drop the official Google, Yelp and Facebook marks into public/logos/ as google.svg,
 * yelp.svg and facebook.svg and they appear here with no code change — the delivery
 * platforms in OrderOnline.astro already work that way. Until then this is the plain text
 * label it has always been. Take the files from each platform's own brand page: Google in
 * particular is strict about its G being used in its four colours and not redrawn.
 */
const logo = source === "direct" ? null : getLogo(source);
const label = LABELS[source];
---
{source === "direct" ? (
  <span class="text-ink-soft">{label}</span>
) : (
  <span class="inline-flex items-center gap-1.5 align-middle">
    {logo && <BrandGlyph slug={source} class="h-3.5 w-auto shrink-0" />}
    {(!logo || logo.kind === "symbol") &&
      (url ? (
        <a href={url} target="_blank" rel="noopener">{label}</a>
      ) : (
        <span class="text-ink-soft">{label}</span>
      ))}
  </span>
)}
