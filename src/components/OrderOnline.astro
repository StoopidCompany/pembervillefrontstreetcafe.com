---
import { getOrderingLinks } from "~/lib/content";
import { getLogo, type LogoSlug } from "~/lib/logos";
import BrandGlyph from "~/components/BrandGlyph.astro";

interface Props {
  /** Extra classes for the button or summary pill. */
  class?: string;
  /** "pill" for the header button, "list" for plain links in the footer. */
  variant?: "pill" | "list";
}

const { class: className, variant = "pill" } = Astro.props;

// A wordmark logo already says the platform's name, so printing it again would stutter.
// With no logo file present, the name is all there is.
const links = (await getOrderingLinks()).map((link) => {
  const slug = link.label.toLowerCase().replace(/\s+/g, "") as LogoSlug;
  const logo = getLogo(slug);
  return { ...link, slug, logo, showName: !logo || logo.kind === "symbol" };
});

const pill =
  "inline-flex items-center gap-1.5 whitespace-nowrap rounded-full bg-brick px-3 py-1.5 text-xs font-semibold uppercase tracking-wider !text-cream hover:!bg-door transition-colors cursor-pointer";
---
{/* The footer stays plain text. Logos sitting in a column of text links came out at
    mismatched optical sizes, and "[Uber Eats logo] Order online" stutters. The marks do
    their job in the header; here the words are tidier. */}
{links.length > 0 && variant === "list" && (
  <ul class:list={["space-y-0.5 text-sm", className]}>
    {links.map((link) => (
      <li>
        <a href={link.href} target="_blank" rel="noopener">Order on {link.label}</a>
      </li>
    ))}
  </ul>
)}

{links.length === 1 && variant === "pill" && (
  <a href={links[0].href} target="_blank" rel="noopener" class:list={[pill, className]}>
    {/* Reversed to cream on the brick button rather than recoloured. */}
    {links[0].logo && <BrandGlyph slug={links[0].slug} class="h-3.5 w-auto" brandColor={false} />}
    Order on {links[0].label}
  </a>
)}

{/* Two or more platforms: a <details> disclosure, so the menu works with no JavaScript
    and stays keyboard-operable. */}
{links.length > 1 && variant === "pill" && (
  <details class:list={["order-online relative", className]}>
    <summary class:list={[pill, "list-none"]}>
      Order Online
      <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M19 9l-7 7-7-7" />
      </svg>
    </summary>
    {/* normal-case: the desktop header nav sets uppercase, which would otherwise shout
        "DOORDASH" at a brand that writes itself DoorDash. */}
    <ul class="absolute right-0 z-50 mt-2 w-52 overflow-hidden rounded-xl border border-crust bg-cream normal-case tracking-normal shadow-lg">
      {links.map((link) => (
        <li class="border-b border-crust/60 last:border-0">
          <a
            href={link.href}
            target="_blank"
            rel="noopener"
            class="flex items-center gap-2.5 px-4 py-3 !text-ink hover:bg-crust/40"
          >
            {link.logo ? (
              <BrandGlyph slug={link.slug} class={`${link.logo.menuHeight} w-auto shrink-0`} />
            ) : (
              <span class="text-sm font-semibold">{link.label}</span>
            )}
            {link.logo && link.showName && (
              <span class="text-sm font-semibold">{link.label}</span>
            )}
          </a>
        </li>
      ))}
    </ul>
  </details>
)}

<style>
  /* Safari still paints the default disclosure triangle without this. */
  .order-online > summary::-webkit-details-marker {
    display: none;
  }
  .order-online > summary::marker {
    content: "";
  }
</style>
