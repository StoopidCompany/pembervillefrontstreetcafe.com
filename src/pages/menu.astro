---
import { render } from "astro:content";
import Base from "~/layouts/Base.astro";
import { getMenu, getPage, getSettings, formatPrice, telHref } from "~/lib/content";

const settings = await getSettings();
const tel = telHref(settings.phone);
const page = await getPage("menu");
const { Content: Intro } = await render(page);
const menu = await getMenu();
const sections = await Promise.all(
  menu.map(async ({ section, items }) => ({
    section,
    items,
    Description: (await render(section)).Content,
  })),
);
---
<Base
  title={page.data.seoTitle ?? page.data.headline}
  description={page.data.description ?? undefined}
>
  <div class="mx-auto max-w-3xl px-5 py-10 lg:px-8">
    <h1 class="text-3xl sm:text-4xl">{page.data.headline}</h1>
    <div class="mt-3 text-ink-soft"><Intro /></div>

    <!-- Jump links: this page is long on a phone, and people arrive looking for one thing. -->
    <nav aria-label="Menu sections" class="mt-6 flex flex-wrap gap-2">
      {sections.map(({ section }) => (
        <a
          href={`#${section.data.slug}`}
          class="rounded-full border border-crust bg-crust/30 px-3 py-1.5 text-xs font-semibold !text-ink hover:!text-brick"
        >
          {section.data.title}
        </a>
      ))}
    </nav>

    {sections.map(({ section, items, Description }) => (
      <section id={section.data.slug} class="mt-12 scroll-mt-28">
        <h2 class="border-b border-crust pb-2 text-2xl">{section.data.title}</h2>
        <div class="mt-3 space-y-2 text-sm text-ink-soft [&_a]:underline"><Description /></div>

        {items.length > 0 && (
          <ul class="mt-5 space-y-5">
            {items.map((item) => (
              <li>
                <div class="flex items-baseline justify-between gap-4">
                  <h3 class="font-display text-lg leading-snug">{item.data.name}</h3>
                  <span class="whitespace-nowrap text-sm font-semibold text-brick">
                    {formatPrice(item.data)}
                  </span>
                </div>
                {item.data.description && (
                  <p class="mt-1 max-w-prose text-sm leading-relaxed text-ink-soft">
                    {item.data.description}
                  </p>
                )}
              </li>
            ))}
          </ul>
        )}
      </section>
    ))}

    {tel && (
      <p class="mt-14 rounded-2xl border border-crust bg-crust/30 p-5 text-sm">
        Prices and dishes change with the seasons. Call us on
        <a href={tel} class="font-semibold">{settings.phone}</a> if you need to check something
        before you come in.
      </p>
    )}
  </div>
</Base>
