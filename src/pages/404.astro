---
import Base from "~/layouts/Base.astro";
import VisitInfo from "~/components/VisitInfo.astro";
import { getSettings, telHref } from "~/lib/content";

const settings = await getSettings();
const tel = telHref(settings.phone);
---
<Base title="Page not found" description="That page isn't here — but the menu, the hours and the phone number are.">
  <div class="mx-auto max-w-2xl px-5 py-16 lg:px-8">
    <p class="font-body text-[0.7rem] uppercase tracking-[0.18em] text-ink-soft">404</p>
    <h1 class="mt-2 text-3xl sm:text-4xl">That page isn't here</h1>
    <p class="mt-3 text-lg text-ink-soft">
      It may have moved when the site was rebuilt. Everything useful is a tap away.
    </p>

    <ul class="mt-6 flex flex-wrap gap-3 text-sm font-semibold">
      <li><a href="/menu" class="rounded-full border border-crust bg-crust/30 px-4 py-2">Menu</a></li>
      <li><a href="/about" class="rounded-full border border-crust bg-crust/30 px-4 py-2">About</a></li>
      <li><a href="/gallery" class="rounded-full border border-crust bg-crust/30 px-4 py-2">Gallery</a></li>
      <li><a href="/reviews" class="rounded-full border border-crust bg-crust/30 px-4 py-2">Reviews</a></li>
      <li><a href="/catering" class="rounded-full border border-crust bg-crust/30 px-4 py-2">Catering</a></li>
      <li><a href="/contact" class="rounded-full border border-crust bg-crust/30 px-4 py-2">Contact</a></li>
    </ul>

    <VisitInfo class="mt-10 bg-crust/30" heading="Or just come in" />

    {tel && (
      <p class="mt-6">
        Still stuck? Call <a href={tel} class="font-semibold">{settings.phone}</a>.
      </p>
    )}
  </div>
</Base>
