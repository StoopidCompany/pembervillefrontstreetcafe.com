---
import { render } from "astro:content";
import Base from "~/layouts/Base.astro";
import Photo from "~/components/Photo.astro";
import VisitInfo from "~/components/VisitInfo.astro";
import { getPage, getSettings, telHref } from "~/lib/content";

const page = await getPage("404");
const { Content } = await render(page);
const settings = await getSettings();
const tel = telHref(settings.phone);

const links = [
  { label: "Menu", href: "/menu" },
  { label: "About", href: "/about" },
  { label: "Gallery", href: "/gallery" },
  { label: "Reviews", href: "/reviews" },
  { label: "Catering", href: "/catering" },
  { label: "Contact", href: "/contact" },
];
---
<Base
  title="Page not found"
  description="That page isn't here — but the menu, the hours and the phone number are."
  social={page.data}
>
  <div class="mx-auto max-w-2xl px-5 py-16 lg:px-8">
    <p class="font-body text-[0.7rem] uppercase tracking-[0.18em] text-ink-soft">404</p>
    <h1 class="mt-2 text-3xl sm:text-4xl">{page.data.headline}</h1>
    <div class="mt-3 text-lg text-ink-soft"><Content /></div>

    {/* Editable in the admin, and the page reads fine with no photo at all. */}
    {page.data.image && (
      <Photo
        src={page.data.image}
        alt={page.data.imageAlt ?? ""}
        sizes="(min-width: 768px) 672px, 100vw"
        loading="eager"
        fetchpriority="high"
        class="mt-8 aspect-[3/2] w-full rounded-2xl object-cover"
      />
    )}

    <ul class="mt-8 flex flex-wrap gap-3 text-sm font-semibold">
      {links.map((link) => (
        <li>
          <a href={link.href} class="rounded-full border border-crust bg-crust/30 px-4 py-2">
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <VisitInfo class="mt-10 bg-crust/30" heading="Or just come in" />

    {tel && (
      <p class="mt-6">
        Still stuck? Call <a href={tel} class="font-semibold">{settings.phone}</a>.
      </p>
    )}
  </div>
</Base>
