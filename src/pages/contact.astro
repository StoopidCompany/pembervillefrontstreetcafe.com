---
import { render } from "astro:content";
import Base from "~/layouts/Base.astro";
import VisitInfo from "~/components/VisitInfo.astro";
import ReviewAsk from "~/components/ReviewAsk.astro";
import { getPage, getSettings, telHref, formatAddress } from "~/lib/content";

const page = await getPage("contact");
const { Content: Intro } = await render(page);
const settings = await getSettings();
const tel = telHref(settings.phone);
const address = formatAddress(settings.address);
const mapQuery =
  page.data.mapQuery ?? [settings.businessName, address].filter(Boolean).join(", ");

// Set at build time. Empty means the form cannot work, and the page says so out loud
// rather than taking an enquiry and dropping it.
const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? "";

const field =
  "w-full rounded-lg border border-crust bg-cream px-4 py-3 text-base focus:border-brick focus:outline-none transition-colors";
const label = "block text-[0.7rem] uppercase tracking-[0.18em] text-ink-soft mb-1.5";

const enquiryTypes = [
  "Catering",
  "Private event",
  "Large party",
  "Feedback",
  "Other",
];
---
<Base
  title={page.data.seoTitle ?? page.data.headline}
  description={page.data.description ?? undefined}
  breadcrumb="Contact"
  social={page.data}
>
  <div class="mx-auto max-w-3xl px-5 py-10 lg:px-8">
    <h1 class="text-3xl sm:text-4xl">{page.data.headline}</h1>
    <div class="mt-3 text-lg text-ink-soft"><Intro /></div>

    <VisitInfo class="mt-8 bg-crust/30" heading="Hours, address and phone" />

    {tel && (
      <a
        href={tel}
        class="mt-6 flex items-center justify-center gap-2 rounded-full bg-brick px-6 py-4 text-base font-semibold uppercase tracking-wider !text-cream hover:!bg-door transition-colors"
      >
        Call {settings.phone}
      </a>
    )}

    <ReviewAsk class="mt-10 bg-crust/30" heading="Already been in?" />

    <section class="mt-12">
      <h2 class="text-2xl">Send us a message</h2>
      <p class="mt-2 text-ink-soft">
        Catering, a private event in the dining room, a big table on a Saturday, or just
        telling us how we did — this reaches us either way.
      </p>
      {page.data.responseTime && (
        <p class="mt-2 text-sm italic text-ink-soft">{page.data.responseTime}</p>
      )}

      {!web3formsKey && (
        <p class="mt-5 rounded-2xl border border-brick/40 bg-brick/10 p-4 text-sm">
          <strong>This form isn't switched on yet.</strong> Nothing sent through it will
          reach the cafe. Please
          {tel ? (
            <> call <a href={tel} class="font-semibold">{settings.phone}</a> instead.</>
          ) : (
            <> call us instead.</>
          )}
          <span class="mt-2 block text-ink-soft">
            Developer: set <code>PUBLIC_WEB3FORMS_KEY</code> in <code>.env.local</code>, and
            as a repository secret for the deploy, before launch.
          </span>
        </p>
      )}

      <form
        class="mt-6 space-y-5"
        id="contact-form"
        action="https://api.web3forms.com/submit"
        method="POST"
      >
        <input type="hidden" name="access_key" value={web3formsKey} />
        <input
          type="hidden"
          name="subject"
          value="New enquiry from pembervillefrontstreetcafe.com"
        />
        <input type="hidden" name="from_name" value={`${settings.businessName} website`} />
        <!-- Honeypot: real people never see it, bots tick it, Web3Forms drops those. -->
        <input
          type="checkbox"
          name="botcheck"
          class="hidden"
          style="display:none"
          tabindex="-1"
          autocomplete="off"
        />

        <div>
          <label for="name" class={label}>Your name</label>
          <input type="text" id="name" name="name" required autocomplete="name" class={field} />
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="email" class={label}>Email</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              class={field}
            />
          </div>
          <div>
            <label for="phone" class={label}>Phone (optional)</label>
            <input type="tel" id="phone" name="phone" autocomplete="tel" class={field} />
          </div>
        </div>

        <div>
          <label for="enquiry-type" class={label}>What's this about?</label>
          <select id="enquiry-type" name="enquiry_type" class={field}>
            <option value="">— Select —</option>
            {enquiryTypes.map((type) => <option>{type}</option>)}
          </select>
        </div>

        <!-- Catering and private events live or die on the date and the headcount, so ask
             for both up front rather than in a second email. -->
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="event-date" class={label}>Date, if you have one</label>
            <input type="date" id="event-date" name="event_date" class={field} />
          </div>
          <div>
            <label for="guests" class={label}>How many people?</label>
            <input type="number" id="guests" name="guests" min="1" max="500" class={field} />
          </div>
        </div>

        <div>
          <label for="message" class={label}>Message</label>
          <textarea id="message" name="message" rows="6" required class={field}></textarea>
        </div>

        <div id="contact-form-status" class="hidden" role="status" aria-live="polite"></div>

        <button
          type="submit"
          id="contact-form-submit"
          class="rounded-full bg-brick px-8 py-3.5 text-sm font-semibold uppercase tracking-wider !text-cream hover:!bg-door transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
        >
          Send message
        </button>
      </form>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl">Find us on the map</h2>
      <iframe
        title={`Map showing ${settings.businessName}`}
        src={`https://maps.google.com/maps?q=${encodeURIComponent(mapQuery)}&output=embed`}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        class="mt-4 aspect-[4/3] w-full rounded-2xl border border-crust sm:aspect-video"
      ></iframe>
    </section>
  </div>
</Base>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const status = document.getElementById("contact-form-status");
  const submit = document.getElementById("contact-form-submit") as HTMLButtonElement | null;

  const NOTICE = "mt-1 rounded-2xl border p-4 text-sm";
  const show = (text: string, kind: "ok" | "bad") => {
    if (!status) return;
    status.textContent = text;
    status.className =
      kind === "ok"
        ? `${NOTICE} border-door/30 bg-door/10 text-ink`
        : `${NOTICE} border-brick/40 bg-brick/10 text-ink`;
  };

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!form || !status || !submit) return;

    const accessKey = form.querySelector<HTMLInputElement>('input[name="access_key"]')?.value;
    if (!accessKey) {
      // Never let the browser post to Web3Forms without a key: it would fail on their end
      // and the customer would never know their enquiry went nowhere.
      show(
        "This form isn't switched on yet, so that message was not sent. Please call the cafe instead — we're sorry.",
        "bad",
      );
      return;
    }

    submit.disabled = true;
    const originalText = submit.textContent;
    submit.textContent = "Sending…";
    status.className = "hidden";

    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
      });
      const result = await response.json().catch(() => ({}) as { success?: boolean; message?: string });
      if (response.ok && result.success !== false) {
        show("Thank you — your message is on its way. We'll be in touch.", "ok");
        form.reset();
      } else {
        throw new Error(result.message ?? "the message service rejected it");
      }
    } catch (error) {
      const detail = error instanceof Error ? error.message : "something went wrong";
      show(
        `Sorry — we couldn't send that (${detail}). Please try again, or call the cafe and we'll sort it out.`,
        "bad",
      );
    } finally {
      submit.disabled = false;
      submit.textContent = originalText;
    }
  });
</script>
