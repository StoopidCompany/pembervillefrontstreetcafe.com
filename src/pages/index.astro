---
import { render } from "astro:content";
import Base from "~/layouts/Base.astro";
import VisitInfo from "~/components/VisitInfo.astro";
import SourceBadge from "~/components/SourceBadge.astro";
import Photo from "~/components/Photo.astro";
import {
  getPage,
  getSettings,
  getSignatureDishes,
  getTestimonials,
  getReviewLink,
  formatPrice,
} from "~/lib/content";

const page = await getPage("home");
const { Content: Intro } = await render(page);
const signatures = await getSignatureDishes(page.data.signatures);

/*
 * There are 80 Google reviews in the repo and publishing most of them is reasonable — but
 * the home page is not a review site. Show the strongest few and let the score line carry
 * the rest. `order` decides which ones surface; scripts/publish-reviews.mjs sets it by
 * rating then recency.
 */
const HOME_REVIEW_LIMIT = 6;
const allTestimonials = await getTestimonials();
const testimonials = allTestimonials.slice(0, HOME_REVIEW_LIMIT);
const { headline, heroSubtext, heroImage, ctaText, ctaHref } = page.data;

const { reviewsSummary } = await getSettings();

// Resolved once per review: its own sourceUrl if it has one, else the platform's.
const reviewLinks = await Promise.all(
  testimonials.map(({ data }) => data.sourceUrl ?? getReviewLink(data.source)),
);

// All-or-nothing, like the address in the JSON-LD: a rating with no count, or a count with
// no rating, says nothing useful, so it shows nothing.
const summary =
  reviewsSummary.rating && reviewsSummary.count
    ? {
        rating: reviewsSummary.rating,
        count: reviewsSummary.count,
        url: reviewsSummary.url,
        platformLabel: reviewsSummary.platform === "yelp" ? "Yelp" : "Google",
      }
    : null;
---
<Base
  title={page.data.seoTitle ?? undefined}
  description={page.data.description ?? undefined}
  flushTop
  social={page.data}
>
  <section class="relative isolate flex min-h-[44vh] items-end sm:min-h-[62vh]">
    <!-- object-top: the only photo of the building is portrait and the sign sits high in it,
         so a wide hero crop has to be anchored to the top to show the cafe's name. -->
    {heroImage && (
      <Photo
        src={heroImage}
        alt=""
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 -z-10 h-full w-full object-cover object-top"
      />
    )}
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-door/90 via-door/70 to-door/40"></div>

    <div class="mx-auto w-full max-w-6xl px-5 pb-12 pt-20 lg:px-8 sm:pb-20">
      <h1 class="max-w-2xl text-balance text-3xl text-cream sm:text-5xl">{headline}</h1>
      {heroSubtext && (
        <p class="mt-4 max-w-xl text-pretty text-cream/90 sm:text-lg">{heroSubtext}</p>
      )}
      {ctaText && ctaHref && (
        <a
          href={ctaHref}
          class="mt-7 inline-block rounded-full bg-brick px-6 py-3 text-sm font-semibold uppercase tracking-wider !text-cream hover:!bg-cream hover:!text-door transition-colors"
        >
          {ctaText}
        </a>
      )}
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-5 lg:px-8">
    <VisitInfo class="relative z-10 -mt-6 bg-cream shadow-sm" heading="Hours & where to find us" />

    <section class="mx-auto mt-14 max-w-2xl text-center">
      <div class="space-y-4 text-lg leading-relaxed text-pretty"><Intro /></div>
    </section>

    {signatures.length > 0 && (
      <section class="mt-16">
        <h2 class="text-center font-display text-2xl sm:text-3xl">What people come back for</h2>
        {/* items-start: a card with a photo is taller, and stretching its neighbour to
            match left a large empty panel. */}
        <ul class="mt-8 grid items-start gap-4 sm:grid-cols-2">
          {signatures.map((dish) => (
            <li class="overflow-hidden rounded-2xl border border-crust">
              {dish.data.image && (
                <Photo
                  src={dish.data.image}
                  alt={dish.data.name}
                  sizes="(min-width: 640px) 50vw, 100vw"
                  class="h-36 w-full object-cover sm:h-40"
                />
              )}
              <div class="p-5">
              <div class="flex items-baseline justify-between gap-4">
                <h3 class="font-display text-xl">{dish.data.name}</h3>
                <span class="whitespace-nowrap text-sm font-semibold text-brick">
                  {formatPrice(dish.data)}
                </span>
              </div>
              {dish.data.description && (
                <p class="mt-2 text-sm leading-relaxed text-ink-soft">{dish.data.description}</p>
              )}
              </div>
            </li>
          ))}
        </ul>
        <p class="mt-8 text-center">
          <a href="/menu" class="font-semibold underline">See the whole menu</a>
          <span class="mx-2 text-ink-soft">·</span>
          <a href="/about" class="font-semibold underline">Read our story</a>
        </p>
      </section>
    )}

    {(testimonials.length > 0 || summary) && (
      <section class="mt-16">
        <h2 class="text-center font-display text-2xl sm:text-3xl">What guests say</h2>

        {testimonials.length > 0 && (
          <ul class="mt-8 grid gap-4 sm:grid-cols-2">
            {testimonials.map(({ data }, i) => (
              <li class="flex gap-4 rounded-2xl border border-crust p-5">
                {/* The initial sits behind the photo, so a Google avatar URL that has
                    rotted or been removed degrades to a lettered circle instead of a
                    broken image. */}
                <span
                  class="relative mt-0.5 grid h-11 w-11 shrink-0 place-items-center overflow-hidden rounded-full bg-crust font-display text-lg text-door"
                  aria-hidden="true"
                >
                  {data.author.trim().charAt(0).toUpperCase()}
                  {data.avatar && (
                    <img
                      src={data.avatar}
                      alt=""
                      width="44"
                      height="44"
                      loading="lazy"
                      decoding="async"
                      referrerpolicy="no-referrer"
                      class="absolute inset-0 h-full w-full object-cover"
                    />
                  )}
                </span>

                <div class="min-w-0">
                  {/* Backstop: a very long review still cannot run the card away. */}
                  <blockquote class="line-clamp-[10] text-pretty leading-relaxed">
                    “{data.quote}”
                  </blockquote>
                  <p class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-ink-soft">
                    <span class="font-semibold text-ink">{data.author}</span>
                    {data.rating && (
                      <span class="text-brick" aria-label={`${data.rating} out of 5`}>
                        {"★".repeat(data.rating)}
                      </span>
                    )}
                    <SourceBadge
                      source={data.source}
                      url={reviewLinks[i]}
                      specific={Boolean(data.sourceUrl)}
                    />
                  </p>
                </div>
              </li>
            ))}
          </ul>
        )}

        {summary && (
          <p class="mt-8 text-center text-sm text-ink-soft">
            {summary.rating}★ on {summary.platformLabel} · {summary.count}{" "}
            {summary.count === 1 ? "review" : "reviews"}
            {" — "}
            <a href="/reviews" class="font-semibold underline">read more</a>
          </p>
        )}
      </section>
    )}
  </div>
</Base>
