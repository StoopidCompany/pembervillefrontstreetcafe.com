---
import { render } from "astro:content";
import Base from "~/layouts/Base.astro";
import VisitInfo from "~/components/VisitInfo.astro";
import SourceBadge from "~/components/SourceBadge.astro";
import {
  getPage,
  getSettings,
  getSignatureDishes,
  getTestimonials,
  formatPrice,
} from "~/lib/content";

const page = await getPage("home");
const { Content: Intro } = await render(page);
const signatures = await getSignatureDishes(page.data.signatures);
const testimonials = await getTestimonials();
const { headline, heroSubtext, heroImage, ctaText, ctaHref } = page.data;

const { reviewsSummary, socials } = await getSettings();

/**
 * Google's API returns no public URL for an individual review, so a synced review links to
 * the listing instead. A hand-entered sourceUrl always wins over this.
 */
function reviewLink(source: "google" | "yelp" | "facebook" | "direct") {
  if (source === "google") return socials.google ?? null;
  if (source === "yelp") return socials.yelp ?? null;
  if (source === "facebook") return socials.facebook ?? null;
  return null;
}

// All-or-nothing, like the address in the JSON-LD: a rating with no count, or a count with
// no rating, says nothing useful, so it shows nothing.
const summary =
  reviewsSummary.rating && reviewsSummary.count
    ? {
        rating: reviewsSummary.rating,
        count: reviewsSummary.count,
        url: reviewsSummary.url,
        platformLabel: reviewsSummary.platform === "yelp" ? "Yelp" : "Google",
      }
    : null;
---
<Base
  title={page.data.seoTitle ?? undefined}
  description={page.data.description ?? undefined}
  flushTop
>
  <section class="relative isolate flex min-h-[44vh] items-end sm:min-h-[62vh]">
    <!-- object-top: the only photo of the building is portrait and the sign sits high in it,
         so a wide hero crop has to be anchored to the top to show the cafe's name. -->
    {heroImage && (
      <img
        src={heroImage}
        alt=""
        width="1920"
        height="2560"
        fetchpriority="high"
        class="absolute inset-0 -z-10 h-full w-full object-cover object-top"
      />
    )}
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-door/90 via-door/70 to-door/40"></div>

    <div class="mx-auto w-full max-w-6xl px-5 pb-12 pt-20 lg:px-8 sm:pb-20">
      <h1 class="max-w-2xl text-balance text-3xl text-cream sm:text-5xl">{headline}</h1>
      {heroSubtext && (
        <p class="mt-4 max-w-xl text-pretty text-cream/90 sm:text-lg">{heroSubtext}</p>
      )}
      {ctaText && ctaHref && (
        <a
          href={ctaHref}
          class="mt-7 inline-block rounded-full bg-brick px-6 py-3 text-sm font-semibold uppercase tracking-wider !text-cream hover:!bg-cream hover:!text-door transition-colors"
        >
          {ctaText}
        </a>
      )}
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-5 lg:px-8">
    <VisitInfo class="relative z-10 -mt-6 bg-cream shadow-sm" heading="Hours & where to find us" />

    <section class="mx-auto mt-14 max-w-2xl text-center">
      <div class="space-y-4 text-lg leading-relaxed text-pretty"><Intro /></div>
    </section>

    {signatures.length > 0 && (
      <section class="mt-16">
        <h2 class="text-center font-display text-2xl sm:text-3xl">What people come back for</h2>
        <ul class="mt-8 grid gap-4 sm:grid-cols-2">
          {signatures.map((dish) => (
            <li class="rounded-2xl border border-crust p-5">
              <div class="flex items-baseline justify-between gap-4">
                <h3 class="font-display text-xl">{dish.data.name}</h3>
                <span class="whitespace-nowrap text-sm font-semibold text-brick">
                  {formatPrice(dish.data)}
                </span>
              </div>
              {dish.data.description && (
                <p class="mt-2 text-sm leading-relaxed text-ink-soft">{dish.data.description}</p>
              )}
            </li>
          ))}
        </ul>
        <p class="mt-8 text-center">
          <a href="/menu" class="font-semibold underline">See the whole menu</a>
        </p>
      </section>
    )}

    {(testimonials.length > 0 || summary) && (
      <section class="mt-16">
        <h2 class="text-center font-display text-2xl sm:text-3xl">What guests say</h2>

        {testimonials.length > 0 && (
          <ul class="mt-8 grid gap-4 sm:grid-cols-2">
            {testimonials.map(({ data }) => (
              <li class="rounded-2xl border border-crust p-5">
                <blockquote class="text-pretty leading-relaxed">“{data.quote}”</blockquote>
                <p class="mt-3 text-sm text-ink-soft">
                  <span class="font-semibold text-ink">{data.author}</span>
                  {data.rating && <>{` · ${data.rating}★`}</>}
                  {" · "}
                  <SourceBadge source={data.source} url={data.sourceUrl ?? reviewLink(data.source)} />
                </p>
              </li>
            ))}
          </ul>
        )}

        {summary && (
          <p class="mt-8 text-center text-sm text-ink-soft">
            {summary.rating}★ on {summary.platformLabel} · {summary.count}{" "}
            {summary.count === 1 ? "review" : "reviews"}
            {summary.url && (
              <>
                {" — "}
                <a href={summary.url} target="_blank" rel="noopener" class="font-semibold underline">
                  see more
                </a>
              </>
            )}
          </p>
        )}
      </section>
    )}
  </div>
</Base>
