---
import Base from "~/layouts/Base.astro";
import SourceBadge from "~/components/SourceBadge.astro";
import ReviewAsk from "~/components/ReviewAsk.astro";
import { getSettings, getTestimonials, getReviewLink } from "~/lib/content";

const { reviewsSummary } = await getSettings();
const reviews = await getTestimonials();

const links = await Promise.all(
  reviews.map(({ data }) => data.sourceUrl ?? getReviewLink(data.source)),
);

const summary =
  reviewsSummary.rating && reviewsSummary.count
    ? {
        rating: reviewsSummary.rating,
        count: reviewsSummary.count,
        url: reviewsSummary.url,
        platformLabel: reviewsSummary.platform === "yelp" ? "Yelp" : "Google",
      }
    : null;
---
<Base
  title="Reviews"
  description="What guests say about Pemberville Front Street Cafe — reviews from people who have eaten in the dining room and at the bar on Front Street."
  breadcrumb="Reviews"
>
  <div class="mx-auto max-w-3xl px-5 py-10 lg:px-8">
    <h1 class="text-3xl sm:text-4xl">What guests say</h1>

    {summary && (
      <p class="mt-3 text-lg text-ink-soft">
        {summary.rating}★ from {summary.count} reviews on {summary.platformLabel}.
        {summary.url && (
          <>
            {" "}
            <a href={summary.url} target="_blank" rel="noopener" class="font-semibold underline">
              Read them all
            </a>.
          </>
        )}
      </p>
    )}

    {reviews.length > 0 ? (
      <ul class="mt-10 space-y-4">
        {reviews.map(({ data }, i) => (
          <li class="flex gap-4 rounded-2xl border border-crust p-5">
            <span
              class="relative mt-0.5 grid h-11 w-11 shrink-0 place-items-center overflow-hidden rounded-full bg-crust font-display text-lg text-door"
              aria-hidden="true"
            >
              {data.author.trim().charAt(0).toUpperCase()}
              {data.avatar && (
                <img
                  src={data.avatar}
                  alt=""
                  width="44"
                  height="44"
                  loading="lazy"
                  decoding="async"
                  referrerpolicy="no-referrer"
                  class="absolute inset-0 h-full w-full object-cover"
                />
              )}
            </span>
            <div class="min-w-0">
              <blockquote class="text-pretty leading-relaxed">“{data.quote}”</blockquote>
              <p class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-ink-soft">
                <span class="font-semibold text-ink">{data.author}</span>
                {data.rating && (
                  <span class="text-brick" aria-label={`${data.rating} out of 5`}>
                    {"★".repeat(data.rating)}
                  </span>
                )}
                <SourceBadge
                  source={data.source}
                  url={links[i]}
                  specific={Boolean(data.sourceUrl)}
                />
              </p>
            </div>
          </li>
        ))}
      </ul>
    ) : (
      <p class="mt-8 text-ink-soft">No reviews on the site yet.</p>
    )}

    <ReviewAsk class="mt-12 bg-crust/30" heading="Been in recently?" />

    <p class="mt-10 text-sm text-ink-soft">
      Reviews are reproduced as guests wrote them. Have a look at
      <a href="/menu">the menu</a> or <a href="/contact">come and find us</a>.
    </p>
  </div>
</Base>
