---
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/manrope";
// ?url gives the hashed build path, so the preload below cannot go stale.
import displayFont from "@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url";
import "~/styles/global.css";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";
import { getSettings, getOrderingLinks, getPage, formatAddress } from "~/lib/content";
import { toOpeningHoursSpecification } from "~/lib/hours";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** Hero pages paint their own full-bleed top; everything else gets normal spacing. */
  flushTop?: boolean;
  /** What this page is called in the breadcrumb trail. Omit on the home page. */
  breadcrumb?: string;
  /** Extra schema.org nodes for this page, e.g. the full Menu on /menu. */
  schema?: unknown[];
}

const {
  title,
  description,
  ogImage,
  flushTop = false,
  breadcrumb,
  schema = [],
} = Astro.props;
const settings = await getSettings();

// The listings name is "Pemberville Front Street Cafe", which pushes titles past the ~60
// characters Google shows. Titles use the short name; the structured data and the footer
// keep the full one, so NAP consistency is unaffected.
const titleName = settings.shortName || settings.businessName;
const pageTitle = title ?? titleName;
const fullTitle = pageTitle === titleName ? pageTitle : `${pageTitle} · ${titleName}`;
const metaDescription = description ?? settings.tagline ?? "";
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
// 1200x630 crop of the storefront, generated by scripts/make-brand-assets.mjs.
const ogImageUrl = new URL(ogImage ?? "/og-default.jpg", Astro.site).toString();

const ga4Id = import.meta.env.PUBLIC_GA4_ID ?? "";

const { street, city, state, zip, latitude, longitude } = settings.address;
// Partial NAP is worse than none in structured data — all or nothing.
const hasFullAddress = Boolean(street && city && state && zip);
const openingHours = toOpeningHoursSpecification(settings.hours);
const sameAs = Object.values(settings.socials).filter((url): url is string => Boolean(url));

const absolute = (path: string) => new URL(path, Astro.site).toString();

// Several real photos beat one OG crop: Google uses these in the knowledge panel.
const galleryPhotos = (await getPage("gallery")).data.images.map((photo) => absolute(photo.image));
const images = [ogImageUrl, ...galleryPhotos];

// Where the pin is. Same documented Maps URL API as "Get directions" in VisitInfo.
const addressLine = formatAddress(settings.address);
const hasMap = addressLine
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
      `${settings.businessName}, ${addressLine}`,
    )}`
  : null;

// One OrderAction per delivery platform, so "order online" intent has something to match.
// Omitted entirely while Gavin has supplied no URLs, like every other optional field here.
const orderActions = (await getOrderingLinks()).map((link) => ({
  "@type": "OrderAction",
  target: {
    "@type": "EntryPoint",
    urlTemplate: link.href,
    actionPlatform: [
      "https://schema.org/DesktopWebPlatform",
      "https://schema.org/MobileWebPlatform",
    ],
  },
}));

/**
 * One Restaurant entity for the whole site. It appears on every page, so it carries a
 * stable @id — that tells Google the pages describe the same restaurant rather than six
 * of them. Anything unconfirmed is omitted rather than guessed: Google would rather be
 * told nothing than told wrong, and a wrong address is the expensive kind of wrong.
 */
const restaurant = {
  "@type": "Restaurant",
  "@id": absolute("/#restaurant"),
  name: settings.businessName,
  ...(settings.shortName &&
    settings.shortName !== settings.businessName && { alternateName: settings.shortName }),
  description: settings.tagline,
  url: new URL("/", Astro.site).toString(),
  hasMenu: absolute("/menu"),
  image: images,
  // Dine-in, so this is who the cafe serves rather than a delivery radius.
  areaServed: ["Pemberville, Ohio", "Wood County, Ohio", "Northwest Ohio"],
  ...(hasMap && { hasMap }),
  ...(settings.phone && { telephone: settings.phone }),
  ...(settings.email && { email: settings.email }),
  ...(hasFullAddress && {
    address: {
      "@type": "PostalAddress",
      streetAddress: street,
      addressLocality: city,
      addressRegion: state,
      postalCode: zip,
      addressCountry: "US",
    },
  }),
  ...(latitude &&
    longitude && {
      geo: { "@type": "GeoCoordinates", latitude, longitude },
    }),
  ...(openingHours.length > 0 && { openingHoursSpecification: openingHours }),
  ...(settings.servesCuisine && { servesCuisine: settings.servesCuisine }),
  ...(settings.priceRange && { priceRange: settings.priceRange }),
  ...(settings.acceptsReservations !== "unknown" && {
    acceptsReservations: settings.acceptsReservations === "yes",
  }),
  ...(sameAs.length > 0 && { sameAs }),
  ...(orderActions.length > 0 && { potentialAction: orderActions }),
};

/*
 * One @graph per page rather than a lone Restaurant repeated five times. The nodes point at
 * each other by @id, so Google reads "these five pages belong to one website, which is
 * about this one restaurant" instead of guessing. Pages add their own nodes via the
 * `schema` prop — /menu passes the full Menu that way, which would otherwise bloat every
 * page with 51 dishes.
 */
const website = {
  "@type": "WebSite",
  "@id": absolute("/#website"),
  url: absolute("/"),
  name: settings.businessName,
  publisher: { "@id": absolute("/#restaurant") },
};

const trail = [
  { name: "Home", item: absolute("/") },
  ...(breadcrumb ? [{ name: breadcrumb, item: canonical }] : []),
];

const webPage = {
  "@type": "WebPage",
  "@id": `${canonical}#webpage`,
  url: canonical,
  name: fullTitle,
  ...(metaDescription && { description: metaDescription }),
  isPartOf: { "@id": absolute("/#website") },
  about: { "@id": absolute("/#restaurant") },
  primaryImageOfPage: ogImageUrl,
  ...(trail.length > 1 && { breadcrumb: { "@id": `${canonical}#breadcrumb` } }),
};

const breadcrumbs =
  trail.length > 1
    ? [
        {
          "@type": "BreadcrumbList",
          "@id": `${canonical}#breadcrumb`,
          itemListElement: trail.map((step, i) => ({
            "@type": "ListItem",
            position: i + 1,
            name: step.name,
            item: step.item,
          })),
        },
      ]
    : [];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [website, restaurant, webPage, ...breadcrumbs, ...schema],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#2c3550" />
    <title>{fullTitle}</title>
    {metaDescription && <meta name="description" content={metaDescription} />}
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    {/* The display font paints the hero headline, so fetch it alongside the CSS rather
        than after it. */}
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />

    {settings.verification.google && (
      <meta name="google-site-verification" content={settings.verification.google} />
    )}
    {settings.verification.bing && (
      <meta name="msvalidate.01" content={settings.verification.bing} />
    )}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="restaurant" />
    <meta property="og:site_name" content={settings.businessName} />
    <meta property="og:title" content={fullTitle} />
    {metaDescription && <meta property="og:description" content={metaDescription} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    {/* GA4, only when PUBLIC_GA4_ID is set at build time. It sets cookies, so the privacy
        note on /contact has to stay in step with whether this is switched on. */}
    {ga4Id && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>
        <script
          is:inline
          define:vars={{ ga4Id }}
          set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','${ga4Id}')`}
        />
      </>
    )}
  </head>
  <body class="min-h-screen flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[60] focus:rounded focus:bg-cream focus:px-3 focus:py-2"
    >
      Skip to content
    </a>
    <Header />
    <!-- Header is fixed; this offset matches its unscrolled height (including the
         mobile hours strip) so nothing hides underneath it. -->
    <main id="main" class:list={["flex-1 pt-[88px] md:pt-[92px]", flushTop ? "" : "pb-4"]}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
