---
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/manrope";
import "~/styles/global.css";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";
import { getSettings, getOrderingLinks } from "~/lib/content";
import { toOpeningHoursSpecification } from "~/lib/hours";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** Hero pages paint their own full-bleed top; everything else gets normal spacing. */
  flushTop?: boolean;
}

const { title, description, ogImage, flushTop = false } = Astro.props;
const settings = await getSettings();

const pageTitle = title ?? settings.businessName;
const fullTitle =
  pageTitle === settings.businessName ? pageTitle : `${pageTitle} · ${settings.businessName}`;
const metaDescription = description ?? settings.tagline ?? "";
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
// 1200x630 crop of the storefront, generated by scripts/make-brand-assets.mjs.
const ogImageUrl = new URL(ogImage ?? "/og-default.jpg", Astro.site).toString();

const { street, city, state, zip, latitude, longitude } = settings.address;
// Partial NAP is worse than none in structured data — all or nothing.
const hasFullAddress = Boolean(street && city && state && zip);
const openingHours = toOpeningHoursSpecification(settings.hours);
const sameAs = Object.values(settings.socials).filter((url): url is string => Boolean(url));

// One OrderAction per delivery platform, so "order online" intent has something to match.
// Omitted entirely while Gavin has supplied no URLs, like every other optional field here.
const orderActions = (await getOrderingLinks()).map((link) => ({
  "@type": "OrderAction",
  target: {
    "@type": "EntryPoint",
    urlTemplate: link.href,
    actionPlatform: [
      "https://schema.org/DesktopWebPlatform",
      "https://schema.org/MobileWebPlatform",
    ],
  },
}));

/**
 * One Restaurant entity for the whole site. It appears on every page, so it carries a
 * stable @id — that tells Google the pages describe the same restaurant rather than six
 * of them. Anything unconfirmed is omitted rather than guessed: Google would rather be
 * told nothing than told wrong, and a wrong address is the expensive kind of wrong.
 */
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Restaurant",
  "@id": new URL("/#restaurant", Astro.site).toString(),
  name: settings.businessName,
  description: settings.tagline,
  url: new URL("/", Astro.site).toString(),
  hasMenu: new URL("/menu", Astro.site).toString(),
  image: ogImageUrl,
  ...(settings.phone && { telephone: settings.phone }),
  ...(settings.email && { email: settings.email }),
  ...(hasFullAddress && {
    address: {
      "@type": "PostalAddress",
      streetAddress: street,
      addressLocality: city,
      addressRegion: state,
      postalCode: zip,
      addressCountry: "US",
    },
  }),
  ...(latitude &&
    longitude && {
      geo: { "@type": "GeoCoordinates", latitude, longitude },
    }),
  ...(openingHours.length > 0 && { openingHoursSpecification: openingHours }),
  ...(settings.servesCuisine && { servesCuisine: settings.servesCuisine }),
  ...(settings.priceRange && { priceRange: settings.priceRange }),
  ...(settings.acceptsReservations !== "unknown" && {
    acceptsReservations: settings.acceptsReservations === "yes",
  }),
  ...(sameAs.length > 0 && { sameAs }),
  ...(orderActions.length > 0 && { potentialAction: orderActions }),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#2c3550" />
    <title>{fullTitle}</title>
    {metaDescription && <meta name="description" content={metaDescription} />}
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="restaurant" />
    <meta property="og:site_name" content={settings.businessName} />
    <meta property="og:title" content={fullTitle} />
    {metaDescription && <meta property="og:description" content={metaDescription} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-screen flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[60] focus:rounded focus:bg-cream focus:px-3 focus:py-2"
    >
      Skip to content
    </a>
    <Header />
    <!-- Header is fixed; this offset matches its unscrolled height (including the
         mobile hours strip) so nothing hides underneath it. -->
    <main id="main" class:list={["flex-1 pt-[88px] md:pt-[92px]", flushTop ? "" : "pb-4"]}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
